# === 의존성 / 런타임 ===
node_modules/
app/.server.pid
*.log
.DS_Store
Thumbs.db

# === 작업 폴더 (개인 메모 / 제작 과정) ===
.omc/
.claude/
note/
making-of/

# === 콘텐츠 가드 ===
# 이 repo는 공개 템플릿이다. 루트에 만든 발표 폴더(예: AI격차/)는
# 기본적으로 제외되어, 강의 콘텐츠가 실수로 public에 노출되지 않는다.
# 공개할 폴더만 아래 화이트리스트에 명시적으로 추가할 것.
/*/
!/app/
!/sample/
!/docs/
!/.obsidian/

# obsidian UI 상태는 추적하지 않음
.obsidian/workspace.json
.obsidian/workspace-mobile.json
